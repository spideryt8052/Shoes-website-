# ==========================================
# STEP HOUSE - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. MongoDB Atlas Database Connection String (Get free at https://mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/step_house_shoes?retryWrites=true&w=majority

# 2. JWT Authentication Secret Key (Any random secure string)
JWT_SECRET=step_house_production_jwt_secret_key_2026_secure!
JWT_EXPIRES_IN=7d

# 3. Environment & URLs
NODE_ENV=production
CLIENT_URL=https://your-vercel-project.vercel.app

# 4. Inventory Settings
LOW_STOCK_THRESHOLD=2

